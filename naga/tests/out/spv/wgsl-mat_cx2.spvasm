    // loads from storage
    let l_s_s = s_sm;
    let l_s_m = s_sm.m;
    let l_s_c_c = s_sm.m[0];
    let l_s_c_v = s_sm.m[idx];
    let l_s_e_cc = s_sm.m[0][0];
    let l_s_e_cv = s_sm.m[0][idx];
